DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/NAMA_DB"
JWT_SECRET="isi-secret-bebas"
PORT=3000

# Untuk fitur Share ke LinkedIn / OG preview CV publik — wajib diisi domain publik saat produksi
# (default fallback ke localhost untuk dev).
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"

# LinkedIn OAuth (Share on LinkedIn + Sign In with LinkedIn using OpenID Connect)
# Redirect URI harus sama persis dengan yang didaftarkan di LinkedIn Developer Portal → Auth.
LINKEDIN_CLIENT_ID="8617ud2xpr3sdu"
LINKEDIN_CLIENT_SECRET="isi-client-secret-dari-dashboard"
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/mahasiswa/linkedin/callback"
LINKEDIN_API_VERSION="202607"

# Integrasi API SIA Universitas Andalas
SIA_API_BASE_URL="https://api.unand.ac.id"
SIA_USER_ID="saps"
SIA_PIN="your-sia-pin"

# Penjadwalan Sinkronisasi Otomatis SIA (Background Cron Job)
SIA_SYNC_AUTO_ENABLED="true"
SIA_SYNC_CRON="0 2 * * *" # Berjalan tiap jam 02:00 WIB (atau ganti sesuai kebutuhan, misal: "0 */6 * * *" tiap 6 jam)